# ==============================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copiá este archivo como ".env" y completá con tus valores reales
# NUNCA subas el archivo .env a GitHub
# ==============================================================

# Google Sheets
GOOGLE_SHEET_ID=aca_va_el_id_de_tu_planilla
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json

# Google Custom Search (para buscar noticias)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Instagram (Meta Graph API)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# X / Twitter
TWITTER_BEARER_TOKEN=

# LinkedIn (opcional - ver README para instrucciones)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
